option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: "unimex.settings"
    PYTHONPATH: "/var/app/current:$PYTHONPATH"
  aws:elasticbeanstalk:container:python:
    WSGIPath: "unimex.wsgi:application"
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: static
commands:
  01_install_pip:
    command: "dnf install -y pip"
  02_install_dependencies:
    command: "dnf install -y mariadb105-devel gcc python3-devel"
container_commands:
  # Acá NO va `makemigrations`: las migraciones son código y viajan en el paquete.
  # Generarlas en el servidor inventa archivos distintos a los del repo (y una
  # migración de datos escrita a mano, como 0047, se pierde: quedaría el DROP
  # TABLE sin la copia previa). El chequeo va en desarrollo, antes de empaquetar:
  # `manage.py makemigrations --check --dry-run`.
  02_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate --noinput"
    leader_only: true
  03_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"